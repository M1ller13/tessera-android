<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Ref: https://developer.android.com/training/articles/security-config.html -->
    <!--
      Tessera (F2): release talks only to the Tessera server over HTTPS, with the system trust store.
      The clear text on 127.0.0.1 / localhost for the dev stand (adb reverse) is in src/debug/res/xml/network_security_config.xml.
    -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
